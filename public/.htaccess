# Configuração Apache para React Router (SPA)
# Este arquivo será copiado para a pasta dist durante o build

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Evita content-negotiation causando caminhos errados
  Options -MultiViews
  
  # Redirecionar todas as requisições para index.html (necessário para React Router)
  RewriteRule ^index\.html$ - [L]
  # Nunca reescrever assets/ (senão JS vira HTML e quebra modules)
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Garantir MIME correto para módulos JS
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
</IfModule>

# Compressão GZIP para melhor performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Evitar cache agressivo do index.html (mitiga mismatch de hash do /assets)
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Segurança - Prevenir listagem de diretórios
Options -Indexes

