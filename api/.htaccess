# Proteção da pasta API
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Configurações para upload de arquivos grandes (até 1GB)
# Nota: Estas configurações podem não funcionar em todos os servidores
# Se não funcionarem, configure diretamente no php.ini
<IfModule mod_php.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

# Limite do Apache para corpo da requisição (1GB = 1073741824 bytes)
LimitRequestBody 1073741824

# Permitir apenas arquivos PHP
<FilesMatch "\.(json|txt|log)$">
    Require all denied
</FilesMatch>

# Proteger arquivo de configuração do banco
<Files "db_config.php">
    Require all denied
</Files>

# Proteger arquivo de usuários (se ainda usar JSON)
<Files "users.json">
    Require all denied
</Files>

# Headers de segurança
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

